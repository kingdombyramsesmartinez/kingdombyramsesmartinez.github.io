# ==============================================================================
# KINGDOM — CABECERAS HTTP DE PRODUCCIÓN (CLOUDFLARE PAGES)
# ==============================================================================
# NOTA IMPORTANTE DE DESPLIEGUE:
# Este archivo está preparado para una futura migración a Cloudflare Pages o hosting
# con soporte de cabeceras perimetrales.
# En GitHub Pages (publicación actual: https://kingdombqto.github.io/KINGDOM/), este
# archivo NO SE APLICA ni procesa por el servidor. Por lo tanto, cabeceras como:
# - Strict-Transport-Security (HSTS)
# - X-Frame-Options
# - Permissions-Policy
# - frame-ancestors
# NO están activas en el entorno actual de GitHub Pages.
# La protección en GitHub Pages se confía a la etiqueta <meta http-equiv="Content-Security-Policy">.
# ==============================================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()
  Cross-Origin-Opener-Policy: same-origin
  Origin-Agent-Cluster: ?1
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; style-src-attr 'none'; script-src-attr 'none'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-src 'none'; manifest-src 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/legal/*
  Cache-Control: public, max-age=3600

/index.html
  Cache-Control: no-cache
